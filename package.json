{
  "name": "waldo-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase로 계정과 데이터를 관리하는 팀 채팅 웹사이트",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
