  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "socket.io-client": "^4.8.4"
  }
}
