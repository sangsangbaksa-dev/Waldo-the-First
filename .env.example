# 서버 주소 (구글 콘솔의 "승인된 리디렉션 URI"는 이 주소 + /auth/google/callback)
BASE_URL=http://localhost:3000
PORT=3000

# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 들어올 수 있는 메일 도메인 (쉼표로 구분, 비우면 모든 구글 계정 허용)
# 예: ALLOWED_EMAIL_DOMAINS=gmail.com
ALLOWED_EMAIL_DOMAINS=

# 구글 키 없이 이메일/이름만으로 들어가는 개발용 로그인. 구글 키가 있으면 기본으로 꺼져.
# 운영 서버에서는 반드시 false.
DEV_LOGIN=

# DB와 첨부 파일을 저장할 폴더
DATA_DIR=data
