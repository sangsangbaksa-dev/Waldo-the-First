# 사이트 주소. https로 시작하면 로그인 쿠키에 Secure가 붙어.
BASE_URL=http://localhost:3000
PORT=3000

# ── Supabase ──────────────────────────────────────────────
# 대시보드 → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon(public) 키: 브라우저에 공개돼도 괜찮은 키
SUPABASE_ANON_KEY=
# service_role 키: 서버 전용 비밀 키. 절대 공개하거나 커밋하지 마.
SUPABASE_SERVICE_ROLE_KEY=
# 첨부 파일을 저장할 Storage 버킷 이름 (없으면 서버가 비공개로 만들어)
SUPABASE_BUCKET=chat-attachments

# DB 접속 정보: 대시보드 위쪽 Connect → Connection String → "Session pooler"에 나온 값을 나눠 적어.
#   host  → DATABASE_HOST     (예: aws-1-ap-southeast-1.pooler.supabase.com)
#   user  → DATABASE_USER     (postgres.프로젝트ID 모양)
#   비밀번호는 DB 비밀번호를 그대로 (@ 같은 기호도 바꾸지 말고, 따옴표 없이)
DATABASE_HOST=
DATABASE_USER=postgres.xxxxxxxx
DATABASE_PASSWORD=
# 내 컴퓨터는 5432(Session pooler), Vercel은 6543(Transaction pooler)
DATABASE_PORT=5432
# 위 세 줄 대신 주소 한 줄로 적어도 돼 (비밀번호의 @는 %40으로 바꿔야 해)
# DATABASE_URL=postgresql://postgres.xxxxxxxx:비밀번호@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# DB 인증서까지 확인하려면 대시보드 → Database → SSL Configuration에서 받은 인증서 파일 경로
DATABASE_CA_CERT=
# DB 연결 수 (무료 플랜은 작게)
DATABASE_POOL_SIZE=10

# ── 기타 ──────────────────────────────────────────────────
# 가입할 수 있는 메일 도메인 (쉼표로 구분, 비우면 누구나)
# 예: ALLOWED_EMAIL_DOMAINS=gmail.com,naver.com
ALLOWED_EMAIL_DOMAINS=
# Render, Railway 같은 프록시 뒤에서 돌릴 때 1 (가입 시도 제한이 사용자 IP 기준으로 동작하도록)
TRUST_PROXY=
